
# =====================================
# PAWRESCUE COMMUNITY API
# =====================================

# Disable directory listing
Options -Indexes

# =====================================
# CENTRALIZED PHP CONFIGURATION
# =====================================

# Automatically load cors.php before
# executing PHP endpoints.

<IfModule mod_php.c>
    php_value auto_prepend_file "C:/xampp/htdocs/pawrescue/pawrescue_api/cors.php"
</IfModule>

<IfModule php_module>
    php_value auto_prepend_file "C:/xampp/htdocs/pawrescue/pawrescue_api/cors.php"
</IfModule>
